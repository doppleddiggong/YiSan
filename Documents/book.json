{
  "title": "YiSan Development Documentation",
  "description": "YiSan 프로젝트 개발 문서 - DevLog, Planning, System Review",
  "author": "DoppledDiggong Team",
  "language": "ko",
  "gitbook": "3.2.3",
  "structure": {
    "readme": "README.md",
    "summary": "SUMMARY.md"
  },
  "plugins": [
    "github",
    "mermaid-gb3",
    "collapsible-menu",
    "back-to-top-button",
    "search-plus",
    "expandable-chapters-small",
    "-lunr",
    "-search"
  ],
  "pluginsConfig": {
    "github": {
      "url": "https://github.com/doppleddiggong/YiSan"
    },
    "mermaid-gb3": {
      "theme": "default"
    }
  },
  "links": {
    "sidebar": {
      "GitHub Repository": "https://github.com/doppleddiggong/YiSan",
      "Doxygen Documentation": "https://doppleddiggong.github.io/YiSan/doxygen/"
    }
  }
}
